<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scene_db</name>
  <version>0.1.0</version>
  <description>SQLite-backed scene memory for the robot. Stores VLM/AprilTag/YOLO detections and their 3D world coordinates so any node can query "what is where".</description>
  <maintainer email="bachala_rajesh@outlook.com">Bachala Rajesh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
