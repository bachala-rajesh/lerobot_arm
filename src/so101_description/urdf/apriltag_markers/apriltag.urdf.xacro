                <?xml version='1.0' encoding='utf-8'?>
<robot name="apriltags" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find so101_description)/urdf/apriltag_marker.xacro" />

    <link name="world"/>
    <joint name="world_to_base" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="world"/>
        <child link="base_link"/>
    </joint>
    
    <!-- Base link for the apriltags -->
    <link name="base_link">
        <inertial>
            <mass value="0.001" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00002" />
        </inertial>
    </link>

    <xacro:apriltag_marker namespace="" name="apriltag1" parent="base_link" 
            family="36h11" ID="00001" apriltag_size="0.10">
        <origin xyz="0.0 0.0 0.0" rpy="0 0 3.14" />
    </xacro:apriltag_marker>




</robot>