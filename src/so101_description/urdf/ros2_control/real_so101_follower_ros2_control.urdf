<?xml version="1.0"?>
<robot name="so101_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- command:=true  → position command interfaces enabled, servos hold position (follower)
       command:=false → no command interfaces, servos are torque-free / backdrivable (leader) -->
  <xacro:arg name="command" default="true" />

  <!-- ID offsets: wrist_yaw occupies id 5 in 6dof, pushing roll to 6 and gripper to 7 -->
  <xacro:if value="${'$(arg dof_type)' == 'dof_6'}">
    <xacro:property name="wrist_roll_id" value="6"/>
    <xacro:property name="gripper_id"    value="7"/>
  </xacro:if>
  <xacro:unless value="${'$(arg dof_type)' == 'dof_6'}">
    <xacro:property name="wrist_roll_id" value="5"/>
    <xacro:property name="gripper_id"    value="6"/>
  </xacro:unless>

  <ros2_control name="so101_$(arg arm_prefix)_sim" type="system">
    <hardware>
      <plugin>feetech_ros2_driver/FeetechHardwareInterface</plugin>
      <param name="usb_port">$(arg usb_port)</param>
      <param name="joint_config_file">$(arg real_robot_joint_config)</param>
    </hardware>

    <joint name="shoulder_pan">
      <param name="id">1</param>
      <xacro:if value="$(arg command)">
        <command_interface name="position"/>
      </xacro:if>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="shoulder_lift">
      <param name="id">2</param>
      <xacro:if value="$(arg command)">
        <command_interface name="position"/>
      </xacro:if>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="elbow_flex">
      <param name="id">3</param>
      <xacro:if value="$(arg command)">
        <command_interface name="position"/>
      </xacro:if>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wrist_flex">
      <param name="id">4</param>
      <xacro:if value="$(arg command)">
        <command_interface name="position"/>
      </xacro:if>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <xacro:if value="${'$(arg dof_type)' == 'dof_6'}">
    <joint name="wrist_yaw">
      <param name="id">5</param>
      <xacro:if value="$(arg command)">
        <command_interface name="position"/>
      </xacro:if>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    </xacro:if>

    <joint name="wrist_roll">
      <param name="id">${wrist_roll_id}</param>
      <xacro:if value="$(arg command)">
        <command_interface name="position"/>
      </xacro:if>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper">
      <param name="id">${gripper_id}</param>
      <xacro:if value="$(arg command)">
        <command_interface name="position"/>
      </xacro:if>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
