<?xml version="1.0"?>
<!-- Scene description: world frame + table only.
     Arms are attached via static transforms in the launch file,
     each under their own namespace (follower/, leader/). -->
<robot name="scene">

  <link name="world"/>

  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <link name="table_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="1.0 1.0 1.0"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="1.0 1.0 1.0"/></geometry>
      <material name="table_color">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
  </link>

</robot>
