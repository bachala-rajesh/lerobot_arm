<?xml version='1.0' encoding='utf-8'?>

<robot name="so101_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="sim_mode"                default="real_robot" />
    <xacro:arg name="moveit_status"           default="false" />
    <xacro:arg name="usb_port"                default="/dev/lerobot_follower" />
    <xacro:arg name="real_robot_joint_config"       default="" />
    <xacro:arg name="command"                default="true" />
    <xacro:arg name="gazebo_controllers_config" default="" />
    <xacro:arg name="arm_prefix" default="follower" />
    <xacro:arg name="dof"   default="5" />
    <!-- Prefix for all URDF link names: "follower_" or "leader_".
         Keeps both arms' TF frames unique in the global tree. -->

    <!-- ros2_control hardware interface — skipped when moveit_status=true -->
    <xacro:if value="${'$(arg moveit_status)' == 'false'}">

        <xacro:if value="${'$(arg sim_mode)' == 'gazebo'}">
            <xacro:include filename="$(find so101_description)/urdf/ros2_control/sim_gazebo_so101_follower_ros2_control.urdf" />
        </xacro:if>

        <xacro:if value="${'$(arg sim_mode)' == 'isaacsim'}">
            <xacro:include filename="$(find so101_description)/urdf/ros2_control/sim_isaacsim_so101_follower_ros2_control.urdf" />
        </xacro:if>

        <xacro:if value="${'$(arg sim_mode)' == 'real_robot'}">
            <xacro:include filename="$(find so101_description)/urdf/ros2_control/real_so101_follower_ros2_control.urdf" />
        </xacro:if>

    </xacro:if>

    <!-- ============ ARM WORLD PLACEMENT — SINGLE SOURCE OF TRUTH ============
         world_joint = where the arm base sits in the world.
         Chosen automatically by sim_mode (and dof for the yaw).
           - gazebo : arm sits on the table (0, 0.40, 0.97). 6 mesh needs -90 deg yaw.
           - else   : world origin (0,0,0) -> REAL ROBOT SAFE default.-->
    <xacro:property name="sim_mode_val" value="$(arg sim_mode)"/>
    <xacro:property name="dof_val"      value="$(arg dof)"/>

    <xacro:if value="${sim_mode_val == 'gazebo'}">
        <xacro:property name="base_xyz" value="0 0.40 0.97"/>
        <xacro:if value="${dof_val == '6'}">
            <xacro:property name="base_rpy" value="0 0 -1.5708"/>
        </xacro:if>
        <xacro:unless value="${dof_val == '6'}">
            <xacro:property name="base_rpy" value="0 0 0"/>
        </xacro:unless>
    </xacro:if>
    <xacro:unless value="${sim_mode_val == 'gazebo'}">
        <xacro:property name="base_xyz" value="0 0 0"/>
        <xacro:property name="base_rpy" value="0 0 0"/>
    </xacro:unless>

    <!-- World anchor — shared root for all arms in the scene. -->
    <link name="world"/>
    <joint name="world_joint" type="fixed">
        <parent link="world"/>
        <child link="$(arg arm_prefix)_base_link"/>
        <origin xyz="${base_xyz}" rpy="${base_rpy}"/>
    </joint>

    <!-- Robot links and joints (base_link → jaw_link) -->
    <xacro:if value="${'$(arg dof)' == '5'}">
        <xacro:include filename="$(find so101_description)/urdf/robots/5dof_so101_arm.urdf.xacro" />
    </xacro:if>
    <xacro:if value="${'$(arg dof)' == '6'}">
        <xacro:include filename="$(find so101_description)/urdf/robots/6dof_so101_arm.urdf.xacro" />
    </xacro:if>

</robot>
