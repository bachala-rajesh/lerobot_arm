<?xml version='1.0' encoding='utf-8'?>
<robot name="so101_follower" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="sim_mode" default="gazebo" />
    <xacro:arg name="moveit_status" default="false" />

    <link name="world"/>

    <joint name="world_to_table" type="fixed">
        <parent link="world"/>
        <child  link="table_link"/>
        <origin xyz="0 0 0.5" rpy="0 0 0"/>
    </joint>

    <link name="table_link">

        <!-- Inertial block is required for physics -->
        <inertial>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <mass value="5.0"/>
            <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
        </inertial>

        <!-- Collision geometry -->
        <collision>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <geometry>
            <box size="1.0 1.0 1.0"/>   <!-- width, depth, thickness -->
            </geometry>
        </collision>

        <!-- Visual geometry -->
        <visual>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <geometry>
            <box size="1.0 1.0 1.0"/>
            </geometry>
            <material name="table_color">
            <color rgba="0.3 0.3 0.3 1.0"/>
            </material>
        </visual>

    </link>

    <joint name="table_to_arm" type="fixed">
        <parent link="table_link"/>
        <child  link="base_link"/>     <!-- your robot's base link name -->
        <origin xyz="0 0.4 0.47" rpy="0 0 0"/>
    </joint>

    <xacro:include filename="$(find so101_description)/urdf/so101_follower_with_ros2_control.urdf.xacro" />
 

</robot>