<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- MoveIt only needs links, joints and limits — skip the ros2_control
        hardware block by forcing moveit_status:=true. The actual hardware
        interface is brought up by so101_control. -->
    <xacro:arg name="moveit_status" default="true"/>
    <xacro:arg name="dof_type" default="dof_6"/>

    <!-- Import so101_arm urdf file -->
    <xacro:include filename="$(find so101_description)/urdf/so101_arm_with_control.urdf.xacro" />

</robot>
