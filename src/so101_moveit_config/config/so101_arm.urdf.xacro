<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import so101_arm urdf file -->
    <xacro:include filename="$(find so101_description)/urdf/so101_arm_with_control.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="so101_arm.ros2_control.xacro" />


    <xacro:so101_arm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
