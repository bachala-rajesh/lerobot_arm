<?xml version="1.0" encoding="UTF-8"?>
<robot name="so101_follower">
    <group name="arm">
        <joint name="shoulder_pan"/>
        <joint name="shoulder_lift"/>
        <joint name="elbow_flex"/>
        <joint name="wrist_flex"/>
        <joint name="wrist_roll"/>
    </group>
    <group name="gripper">
        <joint name="gripper"/>
    </group>

    <group_state name="HOME" group="arm">
        <joint name="elbow_flex" value="0"/>
        <joint name="shoulder_lift" value="0"/>
        <joint name="shoulder_pan" value="0"/>
        <joint name="wrist_flex" value="0"/>
        <joint name="wrist_roll" value="0"/>
    </group_state>
    <group_state name="STRAIGHT_UP" group="arm">
        <joint name="elbow_flex" value="-1.57"/>
        <joint name="shoulder_lift" value="0"/>
        <joint name="shoulder_pan" value="0"/>
        <joint name="wrist_flex" value="0"/>
        <joint name="wrist_roll" value="0"/>
    </group_state>
    <group_state name="RANDOM" group="arm">
        <joint name="elbow_flex" value="0.4231"/>
        <joint name="shoulder_lift" value="0.1794"/>
        <joint name="shoulder_pan" value="0.7556"/>
        <joint name="wrist_flex" value="-1.19"/>
        <joint name="wrist_roll" value="0"/>
    </group_state>
    <group_state name="CLOSE" group="gripper">
        <joint name="gripper" value="-0.1532"/>
    </group_state>
    <group_state name="OPEN" group="gripper">
        <joint name="gripper" value="0.7961"/>
    </group_state>
    <group_state name="OPEN_HALF" group="gripper">
        <joint name="gripper" value="0.3694"/>
    </group_state>

    <end_effector name="gripper" parent_link="follower_gripper_link" group="gripper" parent_group="arm"/>

    <disable_collisions link1="follower_base_link"      link2="follower_shoulder_link"   reason="Adjacent"/>
    <disable_collisions link1="follower_base_link"      link2="follower_upper_arm_link"  reason="Never"/>
    <disable_collisions link1="follower_gripper_link"   link2="follower_jaw_link"        reason="Adjacent"/>
    <disable_collisions link1="follower_gripper_link"   link2="follower_lower_arm_link"  reason="Never"/>
    <disable_collisions link1="follower_gripper_link"   link2="follower_wrist_link"      reason="Adjacent"/>
    <disable_collisions link1="follower_jaw_link"       link2="follower_lower_arm_link"  reason="Never"/>
    <disable_collisions link1="follower_jaw_link"       link2="follower_wrist_link"      reason="Never"/>
    <disable_collisions link1="follower_lower_arm_link" link2="follower_upper_arm_link"  reason="Adjacent"/>
    <disable_collisions link1="follower_lower_arm_link" link2="follower_wrist_link"      reason="Adjacent"/>
    <disable_collisions link1="follower_shoulder_link"  link2="follower_upper_arm_link"  reason="Adjacent"/>
</robot>
